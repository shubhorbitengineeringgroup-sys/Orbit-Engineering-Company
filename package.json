{
  "name": "orbit-engineering-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-target.mjs --target=generic",
    "build:pages": "node scripts/build-target.mjs --target=github-pages",
    "build:vercel": "node scripts/build-target.mjs --target=vercel",
    "build:aws": "node scripts/build-target.mjs --target=aws",
    "build:apache": "node scripts/build-target.mjs --target=apache",
    "build:iis": "node scripts/build-target.mjs --target=iis",
    "build:nginx": "node scripts/build-target.mjs --target=nginx",
    "build:netlify": "node scripts/build-target.mjs --target=netlify",
    "build:cloudflare": "node scripts/build-target.mjs --target=cloudflare",
    "preview": "node scripts/preview.mjs",
    "seo:check": "node scripts/check-build.mjs",
    "hosting:check": "node scripts/check-deployment.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:release": "npm run seo:check && node scripts/package-release.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.4"
  }
}
