# Public HTTPS origin; omit trailing paths, queries and fragments.
VITE_SITE_URL=https://orbitengineering.com
# Root hosts use /. GitHub project Pages uses /repository-name/.
VITE_BASE_PATH=/
# clean for servers with routing; directory for GitHub Pages.
VITE_URL_STYLE=clean
# false for staging/previews: noindex metadata and an empty sitemap.
VITE_INDEXABLE=true
# Public ownership tokens from Google Search Console and Bing Webmaster Tools.
# Leave blank until the property is created. Rebuild after setting them.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
# Optional public IndexNow ownership key: 8–128 letters, digits or hyphens.
# Generate once, keep stable, rebuild, deploy, then run npm run seo:indexnow.
INDEXNOW_KEY=
